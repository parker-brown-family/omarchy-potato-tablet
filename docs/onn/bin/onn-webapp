#!/bin/sh
# onn-webapp <url> [title]: open a web app in a Chromium app window on the onn's desktop, and maximise it.
#
# Omarchy's omarchy-launch-webapp ends in uwsm-app, which needs systemd; this opens the same window
# without it. Chromium's flags live in chromium-flags.conf, which every launch reads. Given the page's
# title, it waits for the window and maximises it, so the app fills the screen above the on-screen
# keyboard instead of sharing it with whatever was already open.
. /etc/onn-omarchy/desktop-env.sh
url=${1:?usage: onn-webapp <url> [window title]}
title=${2:-}
setsid chromium --app="$url" </dev/null >>/tmp/chromium.log 2>&1 &
[ -n "$title" ] || exit 0
i=0
while [ "$i" -lt 60 ]; do
    if hyprctl -j clients | grep -q "\"title\": \"$title\""; then
        # Hyprland 0.56 with Omarchy 4's Lua config: dispatch takes Lua, not "focuswindow title:…".
        hyprctl dispatch "hl.dsp.focus({ window = \"title:^$title\$\" })" >/dev/null
        hyprctl dispatch 'hl.dsp.window.fullscreen({ mode = "maximized" })' >/dev/null
        exit 0
    fi
    sleep 1; i=$((i + 1))
done
echo "onn-webapp: no window titled $title after 60 s" >&2
exit 1
